# Dockerfile.prism
# Runtime image using the PrismML llama.cpp fork (ternary Bonsai kernels).
#
# The fork adds the PQ2_0 / PTQ1_0 ggml types and the Hadamard activation
# runtime that Bonsai 2 requires — stock llama.cpp rejects those types.
# It is a full fork of ggml-org/llama.cpp (branch `prism`, build b10685),
# so it also serves every conventional GGUF the standard image served.
#
# Prerequisites: ./switch-version.sh build-prism stages binaries into prism-bin/
# Build: docker build -f Dockerfile.prism -t llama-server:prism .

FROM nvidia/cuda:12.8.1-runtime-ubuntu24.04

RUN apt-get update && apt-get install -y \
    curl \
    wget \
    jq \
    python3 \
    python3-pip \
    python3-venv \
    libgomp1 \
    && pip3 install --break-system-packages huggingface-hub \
    && rm -rf /var/lib/apt/lists/*

RUN mkdir -p /models /cache /app /usr/local/lib/llama

WORKDIR /app

# Pre-built PrismML fork binaries, staged by switch-version.sh build-prism.
COPY prism-bin/llama-server /app/llama-server
COPY prism-bin/ /usr/local/lib/llama/

RUN chmod +x /app/llama-server /usr/local/lib/llama/llama-* 2>/dev/null || true
RUN echo "/usr/local/lib/llama" > /etc/ld.so.conf.d/llama.conf && ldconfig

COPY entrypoint.sh /app/entrypoint.sh
RUN chmod +x /app/entrypoint.sh
COPY config/ /app/config/
COPY scripts/ /app/scripts/

ENV LLAMA_ARG_HOST=0.0.0.0
ENV LLAMA_ARG_PORT=8080
ENV LLAMA_ARG_JINJA=true

EXPOSE 8080

ENTRYPOINT ["/app/entrypoint.sh"]
